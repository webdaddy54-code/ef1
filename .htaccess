# ==============================================================================
# EnterF1.com - .htaccess
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Settings
# ------------------------------------------------------------------------------
Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Sitemap
    RewriteRule ^sitemap\.xml$ /sitemap.php [L]

# Force HTTPS — DISABLED for staging (Cloudways handles SSL at server level)
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Force www — DISABLED for staging
    # RewriteCond %{HTTP_HOST} !^www\. [NC]
    # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ------------------------------------------------------------------
    # 301 Redirects - British Grand Prix
    # ------------------------------------------------------------------
    RewriteRule ^british-grand-prix$ /races/race.php?slug=british-grand-prix [L,R=301,QSA]
    RewriteRule ^british-grand-prix/where-to-sit-at-silverstone$ /races/where-to-sit.php?guide=where-to-sit-at-silverstone [L,R=301,QSA]
    RewriteRule ^british-grand-prix/silverstone-location$ /races/race.php?slug=british-grand-prix [L,R=301,QSA]
    RewriteRule ^british-grand-prix/facts-and-race-information$ /races/race.php?slug=british-grand-prix [L,R=301,QSA]
    RewriteRule ^british-grand-prix/silverstone-weather$ /races/race.php?slug=british-grand-prix [L,R=301,QSA]
    RewriteRule ^british-grand-prix/gp-history-and-memorable-moments$ /races/race.php?slug=british-grand-prix [L,R=301,QSA]
    RewriteRule ^british-grand-prix/tickets$ /where-to-buy-f1-tickets.php [L,R=301,QSA]
    RewriteRule ^british-grand-prix/camping-at-british-grand-prix-silverstone$ /races/race.php?slug=british-grand-prix [L,R=301,QSA]
